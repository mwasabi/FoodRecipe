@page "/"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="main-wrapper">
    
       <!-- Шапка приложения с динамической кнопкой профиля -->
    <header class="top-header">
        @if (isUserLoggedIn)
        {
            <!-- Если пользователь ВОШЕЛ: только круглая аватарка, открывающая меню -->
            <div class="profile-menu-container">
                <div class="profile-circle-logged" @onclick="ToggleProfileMenu">
                    @userEmail.Substring(0, 1).ToUpper()
                </div>

                <!-- Всплывающее меню пользователя -->
                @if (isProfileMenuOpen)
                {
                    <div class="profile-dropdown-menu">
                        <div class="dropdown-header">
                            <span class="user-status-dot"></span>
                            <span class="user-role-text">Личный кабинет</span>
                        </div>
                        <div class="dropdown-user-info">
                            <p class="user-email-label">Email</p>
                            <p class="user-email-value" title="@userEmail">@userEmail</p>
                        </div>
                        <hr class="dropdown-divider" />
                        <button @onclick="Logout" class="btn-dropdown-logout">
                            <span class="logout-icon-sub">🚪</span> Выйти из аккаунта
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Если пользователь НЕ вошел: обычный силуэт -->
            <button @onclick="OpenAuthModal" class="profile-btn">
                👤
            </button>
        }
    </header>
    <!-- Секция Табов над каруселью -->
<div class="food-tabs-container">
    @foreach (var tab in foodTabs)
    {
        <button class="food-tab-link @(activeTab == tab ? "active-food-tab" : "")" 
                @onclick="() => ChangeTab(tab)">
            @tab
        </button>
    }
</div>

<!-- Основная секция карусели -->
<div class="carousel-container">
    <button class="arrow-btn arrow-left" @onclick="ScrollLeft">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>
    
    <div class="carousel-viewport">
        <!-- Фильтруем массив по активной группе табов -->
        @foreach (var cat in allCategories.Where(c => c.TabGroup == activeTab))
        {
            <div class="category-card" @onclick="() => HandleCategoryClick(cat.Id)">
                
                @if (!string.IsNullOrEmpty(cat.SearchTag))
                {
                    <!-- Прямая рабочая ссылка на случайное кулинарное фото по тегу -->
                   <img class="card-stub-img" 
     src="https://unsplash.com" 
     alt="@cat.Name" />

                }
                else
                {
                    <!-- Если тег пустой — показываем красивую цветную заглушку -->
                    <div class="card-stub-img" style="background: linear-gradient(135deg, rgba(255,168,168,0.15) 0%, rgba(252,255,0,0.05) 100%);"></div>
                }
                
                <div class="card-gradient-overlay"></div>
                <div class="card-info">
                    <h3>@cat.Name</h3>
                    <span>Посмотреть рецепты</span>
                </div>
            </div>
        }
    </div>
    
    <button class="arrow-btn arrow-right" @onclick="ScrollRight">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
    </button>
</div>


</div>

<!-- Модальное окно системы авторизации -->
@if (isAuthModalOpen)
{
    <div class="modal-overlay" @onclick="CloseAuthModal">
        <div class="modal-window" @onclick:stopPropagation>
            
            <button @onclick="CloseAuthModal" class="modal-close-x">✕</button>

            @if (showSuccessScreen)
            {
                <!-- ОКНО 3: Поздравление с успешной регистрацией -->
                <div class="success-screen">
                    <div class="success-icon">🎉</div>
                    <h3>Успешно!</h3>
                    <p class="success-text">Вы успешно зарегистрировались и вошли в систему под почтой <strong>@userEmail</strong>.</p>
                    <button @onclick="CloseAuthModal" class="btn-submit">Отлично, к рецептам!</button>
                </div>
            }
            else
            {
                <!-- Заголовок переключается в зависимости от Входа/Регистрации -->
                <h3>@(isRegistrationMode ? "Регистрация" : "Вход в аккаунт")</h3>
                <p>Добро пожаловать в книгу рецептов</p>

                <!-- Табы выбора режима (Регистрация или Вход) — скрываем на этапе ввода кода -->
                @if (!isCodeStage)
                {
                    <div class="auth-tabs">
                        <button class="tab-btn @(!isRegistrationMode ? "active-tab" : "")" @onclick="() => SetAuthMode(false)">Вход</button>
                        <button class="tab-btn @(isRegistrationMode ? "active-tab" : "")" @onclick="() => SetAuthMode(true)">Регистрация</button>
                    </div>
                }

                <div class="auth-form-container">
                    @if (!isCodeStage)
                    {
                        <!-- Этап 1: Ввод Email -->
                        <div class="input-group">
                            <label for="emailInput">Электронная почта</label>
                            <input id="emailInput" type="email" placeholder="example@mail.com" @bind="userEmail" disabled="@isSending" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="auth-error-msg">@errorMessage</div>
                        }

                        <button class="btn-submit" @onclick="SendCode" disabled="@isSending">
                            @if (isSending)
                            {
                                <span class="spinner-auth"></span> <span>Отправка...</span>
                            }
                            else
                            {
                                <span>Получить код</span>
                            }
                        </button>
                    }
                    else
                    {
                        <!-- Этап 2: Ввод проверочного кода -->
                        <div class="input-group">
                            <label for="codeInput">Код подтверждения из письма</label>
                            <input id="codeInput" type="text" placeholder="Введите код" @bind="verificationCode" disabled="@isVerifying" maxlength="6" style="text-align: center; font-size: 20px; letter-spacing: 4px;" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="auth-error-msg">@errorMessage</div>
                        }

                        <button class="btn-submit" @onclick="VerifyCode" disabled="@isVerifying">
                            @if (isVerifying)
                            {
                                <span class="spinner-auth"></span> <span>Проверить и войти</span>
                            }
                            else
                            {
                                <span>Войти</span>
                            }
                        </button>

                        <button class="btn-back" @onclick="BackToEmail" disabled="@isVerifying">
                            Изменить Email
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
@code {
    // Статус пользователя в системе
    private bool isUserLoggedIn = false;
    
    // Переключение режимов работы формы
    private bool isAuthModalOpen = false;
    private bool isRegistrationMode = false; // false - Вход, true - Регистрация
    private bool isCodeStage = false;         
    private bool showSuccessScreen = false;   // Экран с поздравлением 🎉
    
    private bool isSending = false;        
    private bool isVerifying = false;      
    
    private string userEmail = "";
    private string verificationCode = "";
    private string errorMessage = "";

    private void OpenAuthModal() 
    {
        ResetForm();
        isAuthModalOpen = true;
    }
    
    private void CloseAuthModal() => isAuthModalOpen = false;

    private void SetAuthMode(bool registration)
    {
        isRegistrationMode = registration;
        errorMessage = "";
    }

    private void BackToEmail()
    {
        isCodeStage = false;
        errorMessage = "";
        verificationCode = "";
    }

    private void ResetForm()
    {
        isCodeStage = false;
        showSuccessScreen = false;
        isSending = false;
        isVerifying = false;
        verificationCode = "";
        errorMessage = "";
    }

    private async Task ScrollLeft() => await JSRuntime.InvokeVoidAsync("scrollCarousel", "left");
    private async Task ScrollRight() => await JSRuntime.InvokeVoidAsync("scrollCarousel", "right");

    private async Task SendCode()
    {
        if (string.IsNullOrWhiteSpace(userEmail) || !userEmail.Contains("@"))
        {
            errorMessage = "Пожалуйста, введите корректный Email.";
            return;
        }

        errorMessage = "";
        isSending = true;

        try
        {
            var requestData = new SendCodeModel { Email = userEmail };
            var response = await Http.PostAsJsonAsync("api/Auth/email/send-code", requestData);

            if (response.IsSuccessStatusCode)
            {
                isCodeStage = true;
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrEmpty(errorText) ? errorText : "Ошибка работы сервера.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Не удалось связаться с сервером. Проверь бэкенд.";
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task VerifyCode()
    {
        if (string.IsNullOrWhiteSpace(verificationCode))
        {
            errorMessage = "Введите проверочный код.";
            return;
        }

        errorMessage = "";
        isVerifying = true;

        try
        {
            var requestData = new VerifyCodeModel { Email = userEmail, Code = verificationCode };
            var response = await Http.PostAsJsonAsync("api/Auth/email/verify", requestData);

            if (response.IsSuccessStatusCode)
            {
                isUserLoggedIn = true;

                if (isRegistrationMode)
                {
                    // Если была регистрация — включаем поздравительное окно
                    showSuccessScreen = true;
                }
                else
                {
                    // Если просто вход — закрываем окно
                    CloseAuthModal();
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrEmpty(errorText) ? errorText : "Неверный проверочный код.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ошибка при верификации.";
        }
        finally
        {
            isVerifying = false;
        }
    }
        // Состояние открытия выпадающего меню пользователя
    private bool isProfileMenuOpen = false;

    // Метод переключения видимости меню при клике на аватарку
    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    // Модифицируем существующий метод Logout, чтобы он также закрывал меню
    private void Logout()
    {
        isUserLoggedIn = false;
        isProfileMenuOpen = false; // <-- Сбрасываем меню при выходе
        ResetForm();
        userEmail = "";
    }
